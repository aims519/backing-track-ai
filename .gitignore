# .NET
api/**/bin/
api/**/obj/
api/**/publish/
*.user

# Eval harness run output (generated tracks + JSON reports) — BaseFolderPath is relative to the
# process's working directory when the harness runs, so this can land at api/eval-output/ (cwd
# api/) as well as nested under the project folder (cwd api/eval/...).
api/**/eval-output/

# Test runner output (Microsoft.Testing.Platform --results-directory)
TestResults/

# JetBrains Rider
.idea/

# Xcode / Swift
app/Config/Local.xcconfig
app/**/xcuserdata/
app/**/*.xcuserstate
app/**/DerivedData/
app/**/.build/
app/**/*.xcworkspace/xcuserdata/

# Environment / secrets
.env
*.env
*.private.env.json

# Claude Code — local, uncommitted working agreements
CLAUDE.local.md

# OS
.DS_Store
