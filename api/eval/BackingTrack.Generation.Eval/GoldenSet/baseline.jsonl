// Baseline: clean, idiomatic inputs the pipeline should satisfy on the first candidate.
// A regression here means the core generate → validate path has drifted.
{"id": "baseline-blues-a", "category": "Baseline", "description": "12-bar blues in A, standard swing feel", "rationale": "Simplest realistic request: three dominant chords, 4/4, a style the KB covers well.", "input": {"tempo": 100, "chords": ["A7", "A7", "A7", "A7", "D7", "D7", "A7", "A7", "E7", "D7", "A7", "E7"], "keyRoot": "A", "style": "blues"}, "expect": {"outcome": "Succeeds", "minAttempts": 1, "maxAttempts": 2}}
{"id": "baseline-pop-c", "category": "Baseline", "description": "I–V–vi–IV in C, straight pop feel", "rationale": "The most common pop progression; diatonic triads, nothing to trip validation.", "input": {"tempo": 120, "chords": ["C", "G", "Amin", "F"], "keyRoot": "C", "style": "pop"}, "expect": {"outcome": "Succeeds", "minAttempts": 1, "maxAttempts": 1}}
{"id": "baseline-minor-key-walking-bass", "category": "Baseline", "description": "Minor-key jazz walking bass over Am7/Dm7/Em7 — a clean, idiomatic progression in A Aeolian", "rationale": "Regression guard for the scale matcher's historical major-only assumption (job afceac62-9df3-41ae-850e-f47b8cecd615): before KeyMode existed, this input was wrongly validated against A major and needed repeated repairs. Now that key mode is modeled, it should succeed cleanly like any other idiomatic input.", "input": {"tempo": 132, "chords": ["Amin7", "Dmin7", "Emin7", "Amin7"], "keyRoot": "A", "keyMode": "Aeolian", "style": "jazz"}, "expect": {"outcome": "Succeeds", "minAttempts": 1, "maxAttempts": 1}}
{"id": "baseline-rock-e-timekeeping", "category": "Baseline", "description": "I–IV–V rock in E, straight eighths; checks the hi-hat/ride keeps time", "rationale": "A rock track once came back with the hi-hat thinned out, sounding empty; the KB's rock entry allowed 'eighth or quarter notes' and never mentioned the hi-hat. The entry now asks for a continuous eighth-note hat by default. 6 hits/bar on average separates an eighth-note hat (8) from a quarter-note one (4) while leaving room for crashes and fills.", "input": {"tempo": 120, "chords": ["E", "E", "A", "A", "B", "A", "E", "E"], "keyRoot": "E", "style": "rock"}, "expect": {"outcome": "Succeeds", "minAttempts": 1, "maxAttempts": 2, "minAverageTimekeepingHitsPerBar": 6}}
{"id": "baseline-funk-dorian-vamp", "category": "Baseline", "description": "4-bar Emin7/A9 funk vamp in E Dorian, 4/4", "rationale": "First-attempt funk baseline. The funk cases that exist stress something else (7/8 meter, a 16-bar vamp that tempts the model to stop early); this is the same harmony with nothing to trip validation, so a failure here means plain funk generation has drifted. Dorian is set explicitly, since keyMode defaults to Ionian. Expectations are outcome-only: the KB's funk entry doesn't mandate a continuous hi-hat, so there is no timekeeping floor to assert. maxAttempts is 2 until a calibration run shows whether 1 is realistic.", "input": {"tempo": 104, "chords": ["Emin7", "A9", "Emin7", "A9"], "keyRoot": "E", "keyMode": "Dorian", "style": "funk"}, "expect": {"outcome": "Succeeds", "minAttempts": 1, "maxAttempts": 2}}
{"id": "baseline-reggae-i-iv-v", "category": "Baseline", "description": "8-bar I–IV–V in G, slow reggae, 4/4", "rationale": "Reggae is the one KB style no golden case exercises. Simple major triads that change every two bars, matching the KB's 'progressions move slowly and repeat'. Outcome-only expectations: the one-drop (no kick on beat 1) and the offbeat skank would each need a new CaseExpectations check, so they are not asserted here. maxAttempts is 2 until a calibration run shows whether 1 is realistic.", "input": {"tempo": 76, "chords": ["G", "G", "C", "C", "G", "G", "D", "D"], "keyRoot": "G", "style": "reggae"}, "expect": {"outcome": "Succeeds", "minAttempts": 1, "maxAttempts": 2}}
