// Validator-triggering: inputs that reliably make the first candidate fail deterministic
// validation, so the validate → repair → re-validate loop has to run and recover.
// NOTE: forcing a first-attempt failure purely through input is only probabilistic — see the
// README on fault injection for a deterministic version of these cases.
{"id": "validator-odd-meter-funk", "category": "ValidatorTriggering", "description": "7/8 funk with extended chords — models routinely misplace beats in odd meters", "rationale": "Odd time signature + syncopation is the most common source of BeatPositionOutOfRange / InvalidNoteDuration failures.", "input": {"tempo": 108, "chords": ["E9", "E9", "A9", "E9"], "keyRoot": "E", "style": "funk", "timeSignatureBeatCount": 7, "timeSignatureBeatUnit": 8}, "expect": {"outcome": "Succeeds", "minAttempts": 2, "maxAttempts": 3}}
{"id": "validator-fast-jazz-ii-v-i", "category": "ValidatorTriggering", "description": "Fast jazz ii–V–I with a tight chord rhythm", "rationale": "High tempo compresses note durations; first candidates often emit notes beyond the track end or out of the bass range.", "input": {"tempo": 220, "chords": ["Dmin7", "G7", "Cmaj7", "Cmaj7"], "keyRoot": "C", "style": "jazz"}, "expect": {"outcome": "Succeeds", "minAttempts": 2, "maxAttempts": 3}}
