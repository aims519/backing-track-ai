// Validator-triggering: inputs that tend to make the first candidate fail deterministic
// validation, so the validate → repair → re-validate loop has to run and recover.
// NOTE: forcing a first-attempt failure purely through input is only probabilistic — a strong
// model sometimes nails these first try — so they assert only that generation succeeds within
// the attempt budget, not that a repair happened. See the README on fault injection for a
// deterministic version.
{"id": "validator-odd-meter-funk", "category": "ValidatorTriggering", "description": "7/8 funk with extended chords — models routinely misplace beats in odd meters", "rationale": "Odd time signature + syncopation is the most common source of BeatPositionOutOfRange / InvalidNoteDuration failures.", "input": {"tempo": 108, "chords": ["E9", "E9", "A9", "E9"], "keyRoot": "E", "style": "funk", "timeSignatureBeatCount": 7, "timeSignatureBeatUnit": 8}, "expect": {"outcome": "Succeeds", "maxAttempts": 3}}
{"id": "validator-fast-jazz-ii-v-i", "category": "ValidatorTriggering", "description": "Fast jazz ii–V–I with a tight chord rhythm", "rationale": "High tempo compresses note durations; first candidates often emit notes beyond the track end or out of the bass range.", "input": {"tempo": 220, "chords": ["Dmin7", "G7", "Cmaj7", "Cmaj7"], "keyRoot": "C", "style": "jazz"}, "expect": {"outcome": "Succeeds", "maxAttempts": 3}}
{"id": "validator-silent-bar-long-vamp", "category": "ValidatorTriggering", "description": "16-bar two-chord Dorian funk vamp — models truncate long repetitive progressions, leaving the tail bars silent", "rationale": "LengthInBeats is fixed in code, so a candidate that writes fewer bars than asked surfaces as SilentBar failures on the final bars rather than a length mismatch. 16 near-identical bars maximises the chance the model stops early.", "input": {"tempo": 100, "chords": ["Emin7", "A9", "Emin7", "A9", "Emin7", "A9", "Emin7", "A9", "Emin7", "A9", "Emin7", "A9", "Emin7", "A9", "Emin7", "A9"], "keyRoot": "E", "style": "funk"}, "expect": {"outcome": "Succeeds", "maxAttempts": 3}}
{"id": "validator-minor-key-walking-bass", "category": "ValidatorTriggering", "description": "Minor-key jazz walking bass over Am7/Em7 — scale matcher currently assumes major, so passing tones get rejected", "rationale": "Job afceac62-9df3-41ae-850e-f47b8cecd615: KeyRoot 'A' with Am/Em chords validated against A major's diatonic set instead of A minor/Dorian, causing repeated bass-note repairs that flatten the walking line.", "input": {"tempo": 132, "chords": ["Amin7", "Dmin7", "Emin7", "Amin7"], "keyRoot": "A", "style": "jazz"}, "expect": {"outcome": "Succeeds", "maxAttempts": 1}}
