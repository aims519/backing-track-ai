{
  "Llm": {
    "Provider": "OpenAi"
  },
  "OpenAi": {
    "BaseUrl": "https://api.openai.com/v1/",
    "GenerationModel": "gpt-6.1-sol",
    "RepairModel": "gpt-5.6-luna",
    "CriticModel": "gpt-5.6-luna",
    "GenerationApi": "Responses",
    "RepairApi": "Responses",
    "CriticApi": "Responses",
    "GenerationServiceTier": "Flex",
    "RepairServiceTier": "Flex",
    "CriticServiceTier": "Flex",
    "GenerationMaxOutputTokens": 16000,
    "RepairMaxOutputTokens": 16000,
    "CriticMaxOutputTokens": 16000,
    "ApiKey": "FROM_USER_SECRETS"
  },
  "VoyageAi": {
    "ApiKey": "FROM_USER_SECRETS",
    "RestApiBaseUrl": "https://api.voyageai.com/v1/",
    "EmbeddingModel": "voyage-4-large"
  },
  "TrackGenerationWorkflow": {
    "GenerationMaxAttempts": 3
  },
  "Critic": {
    "PassingScoreThreshold": 100.0,
    "MaxAttempts": 3
  },
  "Pricing": {
    "ServiceTierMultipliers": {
      "flex": 0.5
    },
    "Models": {
      "gpt-5.6-terra": {
        "InputPerMillionTokens": 2.00,
        "OutputPerMillionTokens": 12.00
      },
      "gpt-5.6-luna": {
        "InputPerMillionTokens": 0.20,
        "OutputPerMillionTokens": 1.20
      },
      "gpt-6.1-sol": {
        "InputPerMillionTokens": 2.00,
        "OutputPerMillionTokens": 10.00
      },
      "gpt-6-luna": {
        "InputPerMillionTokens": 0.10,
        "OutputPerMillionTokens": 0.50
      }
    }
  },
  "TrackStorage": {
    "BaseFolderPath": "./eval-output/tracks"
  }
}
