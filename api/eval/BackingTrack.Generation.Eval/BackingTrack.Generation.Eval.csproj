<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Read live LLM / Voyage keys from user secrets, same as the API and the KB embedder. -->
    <UserSecretsId>backing-track-generation-eval</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BackingTrack.Core\BackingTrack.Core.csproj" />
    <ProjectReference Include="..\..\src\BackingTrack.Generation\BackingTrack.Generation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GoldenSet\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- KnowledgeBase\Content\*.jsonl is copied to the output automatically via the transitive
       CopyToOutputDirectory items on the BackingTrack.Generation project reference, so the
       in-memory vector store finds its content next to this binary too. -->

</Project>
