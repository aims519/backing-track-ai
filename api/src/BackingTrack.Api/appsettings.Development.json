{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "BackingTrack.Generation": "Debug"
    }
  },
  "Auth": {
    "ApiKey": "FROM_USER_SECRETS"
  },
  "Otel": {
    "IsEnabled": true,
    "CollectorEndpoint": "http://localhost:4317",
    "CollectorHealthCheckEndpoint": "http://localhost:13133"
  },
  "RateLimit": {
    "PermitLimit": 5,
    "WindowSeconds": 30
  },
  "TrackStorage": {
    "BaseFolderPath": "/tmp/backing-track/tracks/"
  },
  "VoyageAi": {
    "ApiKey": "FROM_USER_SECRETS",
    "RestApiBaseUrl": "https://api.voyageai.com/v1/",
    "EmbeddingModel": "voyage-4-large"
  },
  "OpenAi": {
    "GenerationModel": "gpt-6.1-sol",
    "RepairModel": "gpt-5.6-luna",
    "CriticModel": "gpt-5.6-luna",
    "GenerationApi": "Responses",
    "RepairApi": "Responses",
    "CriticApi": "Responses",
    "GenerationServiceTier": "Flex",
    "RepairServiceTier": "Flex",
    "CriticServiceTier": "Flex",
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "FROM_USER_SECRETS",
    "GenerationMaxOutputTokens": 16000,
    "RepairMaxOutputTokens": 16000,
    "CriticMaxOutputTokens": 16000
  },
  "Llm": {
    "Provider": "OpenAi"
  },
  "TrackGenerationWorkflow": {
    "GenerationMaxAttempts": 10
  }
}
