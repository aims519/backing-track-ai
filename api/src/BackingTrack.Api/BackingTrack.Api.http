# @name healthLive
GET {{HostAddress}}/healthz/live
Accept: application/json

###

# @name healthReady
GET {{HostAddress}}/healthz/ready
Accept: application/json

###

// Valid key: should pass the auth filter
# @name generateJob
POST {{HostAddress}}/tracks/generate
Accept: application/json
Content-Type: application/json
X-API-Key: {{ApiKey}}

{
    "Key": "C",
    "Chords": ["C", "F", "G", "G7"],
    "Tempo": 150,
    "Mode": "Precise",
    "Style": null,
    "TimeSignatureBeatCount": 4,
    "TimeSignatureBeatUnit": 4
}
> {%
    client.global.set("jobId", response.body.id);
%}

###

# @name generateJobInvalidInput
POST {{HostAddress}}/tracks/generate
Accept: application/json
Content-Type: application/json
X-API-Key: {{ApiKey}}

{
    "Key": "",
    "Mode": "InvalidMode",
    "TimeSignatureBeatCount": 1000,
    "TimeSignatureBeatUnit": 1
}

> {%
    client.test("Returns 400 with validation errors", function() {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.errors !== undefined, "Expected an errors object in the response body");
        client.assert(response.body.errors.Mode !== undefined, "Expected a Mode validation error");
    });
%}

###

// Chords is the wrong JSON type (string, not array): should still return the unified
// errors-dictionary shape, not a bare/empty 400 (see GlobalExceptionHandler's
// BadHttpRequestException/JsonException branch, and RouteHandlerOptions.ThrowOnBadRequest
// in Program.cs which forces this path in Production too)
# @name generateJobTypeMismatch
POST {{HostAddress}}/tracks/generate
Accept: application/json
Content-Type: application/json
X-API-Key: {{ApiKey}}

{
    "Key": "C",
    "Chords": "C",
    "Tempo": 175,
    "Mode": "Vibe"
}

> {%
    client.test("Returns 400 with unified validation errors on type mismatch", function() {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.errors !== undefined, "Expected an errors object in the response body");
        client.assert(response.body.errors.Chords !== undefined, "Expected a Chords validation error");
    });
%}

###

// No body at all: should return the unified errors shape (was a 500 before
// GlobalExceptionHandler's BadHttpRequestException branch was widened to cover
// the "no body provided" case, not just JSON type mismatches)
# @name generateJobNoBody
POST {{HostAddress}}/tracks/generate
Accept: application/json
Content-Type: application/json
X-API-Key: {{ApiKey}}

> {%
    client.test("Returns 400 with unified validation errors on missing body", function() {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
        client.assert(response.body.errors !== undefined, "Expected an errors object in the response body");
        client.assert(response.body.errors.Body !== undefined, "Expected a Body validation error");
    });
%}

###

// Wrong key: should be rejected with 401 before reaching the handler
# @name generateJobWrongKey
POST {{HostAddress}}/tracks/generate
Accept: application/json
X-API-Key: wrong-key

###

// No key: should be rejected with 401 before reaching the handler
# @name generateJobNoKey
POST {{HostAddress}}/tracks/generate
Accept: application/json

###

// Poll the job created above: should return its current state
# @name getJobStatus
GET {{HostAddress}}/tracks/status/{{jobId}}
Accept: application/json
X-API-Key: {{ApiKey}}

###

// Unknown job id: should be rejected with 404
# @name getJobStatusUnknownId
GET {{HostAddress}}/tracks/status/00000000-0000-0000-0000-000000000000
Accept: application/json
X-API-Key: {{ApiKey}}

###

// Wrong key: should be rejected with 401 before reaching the handler
# @name getJobStatusWrongKey
GET {{HostAddress}}/tracks/status/{{jobId}}
Accept: application/json
X-API-Key: wrong-key

###

// No key: should be rejected with 401 before reaching the handler
# @name getJobStatusNoKey
GET {{HostAddress}}/tracks/status/{{jobId}}
Accept: application/json

