{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "Critic": {
    "PassingScoreThreshold": 100.0,
    "MaxAttempts": 3
  },
  "Apns": {
    "ServerUrl": "https://api.sandbox.push.apple.com",
    "BundleId": "com.andrewsavory.backingtrack"
  },
  "JobEviction": {
    "SweepIntervalSeconds": 60,
    "JobTtlSeconds": 3600
  }
}
