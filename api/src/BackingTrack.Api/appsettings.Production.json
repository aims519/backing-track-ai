{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "ApiKey": "FROM_ENV"
  },
  "Otel": {
    "bEnabled": true,
    "CollectorEndpoint": "http://localhost:4317",
    "CollectorHealthCheckEndpoint": "http://localhost:13133"
  },
  "RateLimit": {
    "PermitLimit": 5,
    "WindowSeconds": 30
  },
  "TrackStorage": {
    "BaseFolderPath": "/mnt/ssd/backing-tracks/tracks/"
  },
  "VoyageAI": {
    "ApiKey": "FROM_ENV",
    "RestApiBaseUrl": "https://api.voyageai.com/v1/",
    "EmbeddingModel": "voyage-4-large"
  },  
  "OpenAi": {
    "Model": "gpt-5.4-nano",
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "FROM_ENV",
    "MaxOutputTokens": 4096
  },
  "Llm": {
    "Provider": "OpenAi"
  }
}
