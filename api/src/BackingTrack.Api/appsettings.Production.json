{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "ApiKey": "FROM_ENV"
  },
  "Otel": {
    "IsEnabled": true,
    "CollectorEndpoint": "http://localhost:4317",
    "CollectorHealthCheckEndpoint": "http://localhost:13133"
  },
  "RateLimit": {
    "PermitLimit": 5,
    "WindowSeconds": 30
  },
  "TrackStorage": {
    "BaseFolderPath": "/mnt/ssd/backing-tracks/tracks/"
  },
  "VoyageAi": {
    "ApiKey": "FROM_ENV",
    "RestApiBaseUrl": "https://api.voyageai.com/v1/",
    "EmbeddingModel": "voyage-4-large"
  },  
  "OpenAi": {
    "GenerationModel": "gpt-5.4",
    "RepairModel": "gpt-5.4",
    "CriticModel": "gpt-5.4",
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "FROM_ENV",
    "GenerationMaxOutputTokens": 4096,
    "RepairMaxOutputTokens": 4096,
    "CriticMaxOutputTokens": 4096
  },
  "Llm": {
    "Provider": "OpenAi"
  },  
  "TrackGenerationWorkflow": {
    "GenerationMaxAttempts": 5
  }
}
