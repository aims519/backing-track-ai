{
  "type": "object",
  "properties": {
    "NoteCorrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "FailureType": {
            "type": "string",
            "enum": [
              "InvalidTrackLengthInBeats",
              "InvalidDrumNoteChoice",
              "InvalidBassNoteChoice",
              "InvalidChordVoicingNoteChoice",
              "BassNoteOutOfExpectedRange",
              "ChordVoicingNoteOutOfExpectedRange",
              "InvalidMidiVelocity",
              "PartEmpty",
              "BeatPositionOutOfRange",
              "InvalidNoteDuration",
              "NoteBeyondTrackEnd",
              "SilentBar"
            ]
          },
          "Original": {
            "description": "The note being corrected, tagged by which part it belongs to.",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "$type": { "type": "string", "enum": ["drum"] },
                  "BeatPosition": { "type": "number" },
                  "DurationInBeats": { "type": "number" },
                  "MidiNote": { "type": "integer" },
                  "Velocity": { "type": "integer" }
                },
                "required": ["$type", "BeatPosition", "DurationInBeats", "MidiNote", "Velocity"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "$type": { "type": "string", "enum": ["bass"] },
                  "BeatPosition": { "type": "number" },
                  "DurationInBeats": { "type": "number" },
                  "MidiNote": { "type": "integer" },
                  "Velocity": { "type": "integer" }
                },
                "required": ["$type", "BeatPosition", "DurationInBeats", "MidiNote", "Velocity"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "$type": { "type": "string", "enum": ["chord"] },
                  "BeatPosition": { "type": "number" },
                  "DurationInBeats": { "type": "number" },
                  "MidiNotes": { "type": "array", "items": { "type": "integer" } },
                  "Velocity": { "type": "integer" }
                },
                "required": ["$type", "BeatPosition", "DurationInBeats", "MidiNotes", "Velocity"],
                "additionalProperties": false
              }
            ]
          },
          "NewBeatPosition": { "type": ["number", "null"] },
          "NewDurationInBeats": { "type": ["number", "null"] },
          "NewMidiNotes": { "type": ["array", "null"], "items": { "type": "integer" } },
          "NewVelocity": { "type": ["integer", "null"] }
        },
        "required": ["FailureType", "Original", "NewBeatPosition", "NewDurationInBeats", "NewMidiNotes", "NewVelocity"],
        "additionalProperties": false
      }
    },
    "NewDrumPart": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "BeatPosition": { "type": "number" },
          "DurationInBeats": { "type": "number" },
          "MidiNote": { "type": "integer" },
          "Velocity": { "type": "integer" }
        },
        "required": ["BeatPosition", "DurationInBeats", "MidiNote", "Velocity"],
        "additionalProperties": false
      }
    },
    "NewBassPart": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "BeatPosition": { "type": "number" },
          "DurationInBeats": { "type": "number" },
          "MidiNote": { "type": "integer" },
          "Velocity": { "type": "integer" }
        },
        "required": ["BeatPosition", "DurationInBeats", "MidiNote", "Velocity"],
        "additionalProperties": false
      }
    },
    "NewChordVoicingPart": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "BeatPosition": { "type": "number" },
          "DurationInBeats": { "type": "number" },
          "MidiNotes": { "type": "array", "items": { "type": "integer" } },
          "Velocity": { "type": "integer" }
        },
        "required": ["BeatPosition", "DurationInBeats", "MidiNotes", "Velocity"],
        "additionalProperties": false
      }
    }
  },
  "required": ["NoteCorrections", "NewDrumPart", "NewBassPart", "NewChordVoicingPart"],
  "additionalProperties": false
}
