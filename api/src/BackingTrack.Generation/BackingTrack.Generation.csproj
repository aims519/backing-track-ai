<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The AOT publish turns this on for every project anyway; setting it here makes normal builds
         and tests run the same generated binding code that ships, instead of the reflection binder
         (which can silently disagree, e.g. over init-only settings properties). -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackingTrack.Core\BackingTrack.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="System.Numerics.Tensors" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
  </ItemGroup>

  <ItemGroup>
    <None Include="KnowledgeBase\Content\*.jsonl" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Steps\TrackRepair\track-repair-patch.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
