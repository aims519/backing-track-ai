<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Partial Info.plist. Xcode still generates the bulk of the plist from build settings
  (GENERATE_INFOPLIST_FILE = YES in project.yml); the keys here are merged on top. It exists
  only to hold UILaunchScreen, which is a nested dictionary and so has no INFOPLIST_KEY_* build
  setting to express it. Keep flat keys in project.yml as INFOPLIST_KEY_* — put only genuinely
  nested plist structure here.
-->
<plist version="1.0">
<dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
</dict>
</plist>
