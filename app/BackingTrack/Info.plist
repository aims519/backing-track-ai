<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Partial Info.plist. Xcode still generates the bulk of the plist from build settings
  (GENERATE_INFOPLIST_FILE = YES in project.yml); the keys here are merged on top. Mostly for
  nested plist structure that has no INFOPLIST_KEY_* build setting — keep flat keys in
  project.yml as INFOPLIST_KEY_* where possible.
-->
<plist version="1.0">
<dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>

	<!--
	  API base URL, from the API_BASE_URL build setting (project.yml / Config/Local.xcconfig).
	  A flat key, but it lives here rather than as INFOPLIST_KEY_APIBaseURL in project.yml
	  because the INFOPLIST_KEY_* mechanism only covers Apple's known keys — a custom key needs
	  to be a real plist entry for $(...) substitution to happen at merge time. Read by
	  APIConfiguration at launch.
	-->
	<key>APIBaseURL</key>
	<string>$(API_BASE_URL)</string>

	<!--
	  Seconds between polls of GET /tracks/status on the generation progress screen, from the
	  STATUS_POLL_INTERVAL build setting (project.yml). Same $(...)-substitution reason as
	  APIBaseURL above: a custom key has to be a real plist entry, not an INFOPLIST_KEY_*.
	  Read by PollingConfiguration; a missing or bad value falls back to a default, it isn't
	  fatal the way an unset APIBaseURL is.
	-->
	<key>StatusPollInterval</key>
	<string>$(STATUS_POLL_INTERVAL)</string>

	<!-- Prevent iOS suspending the audio engine on screen lock -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
