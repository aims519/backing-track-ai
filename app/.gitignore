# The .xcodeproj is generated by XcodeGen from project.yml — see README.md. Regenerate it
# rather than committing it, to avoid pbxproj merge conflicts.
*.xcodeproj/

# Xcode user-specific state (window layout, breakpoints, selected scheme) — machine-local.
xcuserdata/

# Build products / derived data, if Xcode is ever pointed at an in-tree DerivedData location.
build/
DerivedData/

# Swift Package Manager local state (not used yet, but harmless to pre-empt).
.swiftpm/

.DS_Store
